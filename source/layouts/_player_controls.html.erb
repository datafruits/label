<div class='jp-audio'>
  <div class='jp-type-single'>
    <div id="jp-interface-<%=num%>" class="jp-interface">
      <div class='jp-controls-track-<%=num%>'>
          <a class='jp-play' href='#' tabindex='1'></a>
          <a class='jp-pause' href='#' tabindex='1'></a>
          <span><%=track%></span>
      </div>
      <div class='jp-progress'>
        <div class='jp-seek-bar'>
          <div class='jp-play-bar'></div>
        </div>
      </div>
    </div>
  </div>
</div>
