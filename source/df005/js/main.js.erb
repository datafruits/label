<% settings.df005.each do |track| %>
  $("#track-player-<%=track[:num]%>").jPlayer({
    ready: function () {
      $(this).jPlayer("setMedia", {
        mp3: "https://s3.amazonaws.com/DF005/<%="#{track[:mp3]}"%>"
      });
    },
    swfPath: "/hyperfruit/js/vendor",
    preload: "none",
    supplied: "mp3",
    wmode: "window",
    solution: "html, flash",
    cssSelectorAncestor: "#jp-interface-<%=track[:num]%>",
    ended: function(){
      <% if track[:num].to_i < tracks.length %>
        $("#track-player-<%=sprintf("%02i",track[:num].to_i+1)%>").jPlayer("play");
      <% end %>
    },
    play: function(){
      console.log('play...');
      console.log("<%=track[:image]%>");
      $(".image").css("background-image", "url(<%=track[:image]%>)");
    },
  }).bind($.jPlayer.event.play, function() { // Using a jPlayer event to avoid both jPlayers playing together.                        
    $(this).jPlayer("pauseOthers");                                                                                             
  });
<% end %>

$('.shiny').rainbow({
  animate:true,
  animateInterval:50,
  pauseLength:500,
  pad:true,
  colors:[
  'rgb(153, 204, 255);',
  'rgb(173, 224, 255);',
  'rgb(193, 244, 255);',
  'rgb(213, 264, 255);',
  'rgb(193, 244, 255);',
  'rgb(173, 224, 255);',
  'rgb(153, 204, 255);']
});

$("#tracks, #title, #social, #download").draggable();
